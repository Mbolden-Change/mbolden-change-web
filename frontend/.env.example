# Copy to .env.local (or .env) in this folder — next to package.json, not in app/
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-04

# Optional — only needed for Action Network form submissions
ACTION_NETWORK_FORM_ID=
ACTION_NETWORK_API_KEY=

# Shared with the Sanity webhook that calls /api/revalidate on publish, so
# changes show on the site straight away. Any long random string.
SANITY_REVALIDATE_SECRET=
